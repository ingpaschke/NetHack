# NetHack 5.0 options for Helios (nethack.cnf).  NetHack reads
# $HOME/nethack.cnf if it exists, else this file in the playground.
#
# The Helios console window and xterm under Helios X both understand the
# ANSI cursor and attribute sequences from /helios/etc/termcap.  Map
# symbols stay plain ASCII.
OPTIONS=time,showexp,showscore,!autopickup
# the new-player tutorial: delete this line to be asked for it
OPTIONS=!tutorial
OPTIONS=pickup_types:$?!/="+
OPTIONS=number_pad:0
OPTIONS=menustyle:traditional
# The 25-line console window has room for the two status lines.
# OPTIONS=color   (only if your terminal does ANSI colour; termcap has none)
