# NetHack 5.0 - Atari ST/TT/Falcon Configuration
#
# Directory paths (relative to the game directory)
HACKDIR=.
LEVELDIR=levels
SAVEDIR=save

# Tile mode.  Use ascii_map for the character map instead (F2 toggles
# between tiles and ASCII at runtime).
OPTIONS=!ascii_map

# General options
OPTIONS=color,hilite_pet,number_pad

# Tutorial: with neither line set, NetHack asks at startup whether to
# play the tutorial.  Uncomment 'tutorial' to force-start it; uncomment
# '!tutorial' to skip the prompt entirely.
#OPTIONS=tutorial
#OPTIONS=!tutorial

# Autopickup: gold, scrolls, potions, wands, rings, amulets, spellbooks.
OPTIONS=autopickup,pickup_thrown
OPTIONS=pickup_types:$?!/="+

# Menu colors: highlight blessed/cursed status in inventory listings.
# Anchored with leading spaces so 'uncursed' doesn't match 'cursed'.
#
# Color names (16):
#   black  red  green  brown  blue  magenta  cyan  gray
#   orange  light green  yellow  light blue  light magenta
#   light cyan  white  no color
#   aliases: grey, purple, bright red/green/blue/magenta/cyan, transparent
#
# Optional attributes (combine via '&'):
#   none  bold  dim  italic  underline  blink  inverse
OPTIONS=menucolors
MENUCOLOR=" cursed "=red&bold
MENUCOLOR=" blessed "=green
MENUCOLOR=" uncursed "=cyan
MENUCOLOR=" holy water"=cyan
MENUCOLOR=" unholy water"=red&bold
# Worn / wielded gear stands out in the inventory list.
MENUCOLOR=" \\(being worn\\)$"=green
MENUCOLOR=" \\(weapon in hand\\)$"=green
MENUCOLOR=" \\(wielded\\)$"=green

# --- Tree-parser smoke test (commented out) ---------------------------
# Uncomment the lines below to exercise the G_xxx glyph-name parser
# via the customcolor option.  If the parser is working, the config
# loads without error and the named entities will appear in the listed
# colors when seen in-game.  Covers several glyph categories:
#   monsters (male/female/pet variants), corpses, objects, dungeon
#   features.
#OPTIONS=customcolors
#OPTIONS=customcolor:G_male_red_dragon/red
#OPTIONS=customcolor:G_pet_male_little_dog/green
#OPTIONS=customcolor:G_male_dwarf_leader/blue
#OPTIONS=customcolor:G_body_red_dragon/red
#OPTIONS=customcolor:G_scroll_of_identify/yellow
#OPTIONS=customcolor:G_wand_of_wishing/magenta
